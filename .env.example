# 云服务器 Docker 部署环境变量（docker compose 自动读取本文件）
# 用法：cp .env.example .env 后修改；.env 不要提交到 git

# 【必填】JWT 签名密钥，请换成足够长的随机字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-a-long-random-string

# 对外暴露的 Web 端口（默认 80；若服务器 80 被占用可改为 8888 等）
WEB_PORT=80

# 同源部署时留空即可（前端与 /api 共用一个域名，不会触发跨域）
# 仅当把前端单独部署到其它域名时，才填写该域名（逗号分隔多个）
CORS_ORIGINS=

# 前端请求后端的地址：留空 = 同源（推荐）
VITE_API_BASE_URL=

# AI 分类（留空 AI_API_KEY 时自动使用关键词规则兜底，系统仍可完整演示）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# AI 置信度阈值，低于该值的条目进入“待确认”
AI_CONFIDENCE_THRESHOLD=0.7
