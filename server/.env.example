# 服务端口
PORT=8080

# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=please-change-me-in-production

# 数据库文件与上传文件存放目录（默认在 server/data 与 server/uploads）
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# CORS 白名单：允许访问后端的前端域名，逗号分隔。
# 留空表示不限制（仅建议本地开发）；公网部署时务必填写前端域名。
# 例如：CORS_ORIGINS=https://your-app.vercel.app,https://your-pages.pages.dev
CORS_ORIGINS=

# AI 配置（也可在管理员端“系统配置”中修改，数据库中配置优先；此处作为初始值）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 置信度阈值：低于该值的条目进入“待确认”
AI_CONFIDENCE_THRESHOLD=0.7
